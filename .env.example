PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/civicsense_db
# Fallback DNS resolvers used when the system DNS refuses SRV lookups (mongodb+srv://)
DNS_SERVERS=8.8.8.8,1.1.1.1
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
